{
  "name": "nanas-kitchens",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "clean:local": "bash ./scripts/clean-local-builds.sh",
    "dev:local": "bash ./scripts/run-local.sh",
    "stripe:listen": "node scripts/stripe-listen.cjs",
    "preview": "node scripts/preview/run.cjs",
    "test:preview": "node --test scripts/preview/environment.test.cjs",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0"
  },
  "packageManager": "pnpm@9.12.0"
}
