# Secrets — never commit real env files (.env.example is the template)
.env
*.env.local

# Node
node_modules/
dist/
.next/
coverage/
*.tsbuildinfo

# Java (apps/api-java)
target/
*.class
hs_err_pid*

# Gradle / Kotlin Multiplatform generated state
.gradle/
build/

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store

# Local tooling state
.claude/
*.log

# tsc emits to dist/ (see packages/core/tsconfig.json); stale output used to sit next to
# the sources here and shipped an outdated copy of crypto.ts into git.
packages/core/src/*.js
packages/core/src/*.js.map
packages/core/src/*.d.ts

# Local agent tooling. A branch once carried ~2,500 lines of these into the repo by
# accident, plus a submodule pointer with no .gitmodules; this is a public repo and none
# of it belongs here. Keep them out rather than re-deleting them after every merge.
skills/
original-skills/
skills-lock.json
.agents/
